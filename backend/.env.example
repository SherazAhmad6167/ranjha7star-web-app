# Copy this file to .env and fill in real values.
# Never commit .env to git.

# ── Server 1 (103.66.149.194 — 194.1002) ─────────────────────────────────────
# REST base URL (for reference only — backend uses binary API on MIKROTIK_PORT)
MIKROTIK_BASE_URL=https://103.66.149.194:1002/rest
# Binary API (port 8728 by default); enable: /ip service set api disabled=no
MIKROTIK_HOST=103.66.149.194
MIKROTIK_PORT=8728
MIKROTIK_USER=saqibr
MIKROTIK_PASS=change_me

# ── Server 2 (103.66.149.195 — 195.9998) ─────────────────────────────────────
MIKROTIK_BASE_URL2=https://103.66.149.195:9998/rest
MIKROTIK_HOST_2=103.66.149.195
MIKROTIK_PORT_2=8728
MIKROTIK_USER_2=saqibr
MIKROTIK_PASS_2=change_me

# Port this proxy server listens on
PORT=3000

# Allowed Angular origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:4200,https://your-firebase-app.web.app

# ── ZalUltra ISP CRM ─────────────────────────────────────────────────────────
# Panel is plain HTTP, so all calls are proxied through this server.
ZAL_BASE_URL=http://182.180.126.189
ZAL_USER=qaisar
ZAL_PASS=change_me
# Required by nearly every ZalUltra endpoint.
# Find them with GET /zal/isps and GET /zal/branches?isp_id=<id>
ZAL_ISP_ID=2
ZAL_BRANCH_ID=5
